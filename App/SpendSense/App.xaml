<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SpendSense"
             x:Class="SpendSense.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Native page background per theme; mirrors the ss-bg token in wwwroot/css/tokens.css. -->
            <Color x:Key="PageBackgroundLight">#F5F7FA</Color>
            <Color x:Key="PageBackgroundDark">#12151C</Color>

            <!--
                For information about styling .NET MAUI pages
                please refer to the documentation:
                https://go.microsoft.com/fwlink/?linkid=2282329
            -->

        </ResourceDictionary>
    </Application.Resources>
</Application>
