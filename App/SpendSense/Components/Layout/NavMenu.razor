<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
    <MudNavGroup Title="Transactions" Icon="@Icons.Material.Filled.Receipt" Expanded="true">
        <MudNavLink Href="/transactions" Match="NavLinkMatch.Prefix">All</MudNavLink>
        <MudNavLink Href="/recurring-transactions" Match="NavLinkMatch.Prefix">Recurring</MudNavLink>
    </MudNavGroup>
    <MudNavGroup Title="Budget" Icon="@Icons.Material.Filled.AccountBalance" Expanded="true">
        <MudNavLink Href="/monthly-budgets" Match="NavLinkMatch.Prefix">Monthly Budgets</MudNavLink>
        <MudNavLink Href="/goals" Match="NavLinkMatch.Prefix">Goals</MudNavLink>
    </MudNavGroup>
    <MudNavLink Href="/trends" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.TrendingUp">Trends</MudNavLink>
    <MudNavGroup Title="Settings" Icon="@Icons.Material.Filled.Settings">
        <MudNavLink Href="/categories" Match="NavLinkMatch.Prefix">Categories</MudNavLink>
        <MudNavLink Href="/currencies" Match="NavLinkMatch.Prefix">Currencies</MudNavLink>
        <MudNavLink Href="/settings" Match="NavLinkMatch.Prefix">Preferences</MudNavLink>
    </MudNavGroup>
    @if (IsDebug)
    {
        <MudNavLink Href="/dev/gallery" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Palette">Design gallery</MudNavLink>
    }
</MudNavMenu>

@code {
#if DEBUG
    static readonly bool IsDebug = true;
#else
    static readonly bool IsDebug = false;
#endif
}
