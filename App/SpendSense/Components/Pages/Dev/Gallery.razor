@page "/dev/gallery"
@using SpendSense.Common.Models
@using SpendSense.Common.Models.Enums
@using SpendSense.Common.Services
@inject SettingsService Settings

@* Design-system gallery for reviewers. Compiled into every build, but only renders in DEBUG. *@

@if (!IsDebug)
{
    <NotFound />
}
else
{
    <PageHeader Title="Design gallery">
        <Actions>
            <MudSelect Value="Settings.ThemeMode" ValueChanged="OnThemeChanged" T="ThemeMode" Label="Theme" Dense="true" Style="min-width: 120px;">
                <MudSelectItem Value="ThemeMode.System">System</MudSelectItem>
                <MudSelectItem Value="ThemeMode.Light">Light</MudSelectItem>
                <MudSelectItem Value="ThemeMode.Dark">Dark</MudSelectItem>
            </MudSelect>
            <MudSwitch Value="Settings.HideAmounts" ValueChanged="OnHideChanged" T="bool" Label="Hide amounts" Color="Color.Primary" />
        </Actions>
    </PageHeader>

    <SectionHeader Title="Money" />
    <div class="gallery-row">
        <Money Amount="1234.5" />
        <Money Amount="-62.1" />
        <Money Amount="180" Signed="true" Tone="MoneyTone.Income" />
        <Money Amount="-260" Tone="MoneyTone.Error" />
        <Money Amount="-12.5" Tone="MoneyTone.Auto" />
        <Money Amount="3200" Decimals="0" Size="MoneySize.Small" Tone="MoneyTone.Muted" />
    </div>
    <Money Amount="660" Size="MoneySize.Large" />

    <SectionHeader Title="Hero balance and stats" />
    <HeroBalanceCard Label="Balance this month" Amount="660">
        <StatTile Label="Income"><Money Amount="3200" Decimals="0" /></StatTile>
        <StatTile Label="Expenses"><Money Amount="2140" Decimals="0" /></StatTile>
        <StatTile Label="Savings"><Money Amount="400" Decimals="0" Tone="MoneyTone.Income" /></StatTile>
    </HeroBalanceCard>

    <SectionHeader Title="List rows">
        <Actions><a href="/dev/gallery">See all</a></Actions>
    </SectionHeader>
    <ListRow Title="Whole Foods Market" Subtitle="Groceries · Today" Href="/dev/gallery">
        <Leading><IconTile Icon="@Icons.Material.Filled.ShoppingCart" Circle="true" /></Leading>
        <Trailing><Money Amount="-62.1" /></Trailing>
    </ListRow>
    <ListRow Title="Freelance payment" Subtitle="Income · Yesterday">
        <Leading><IconTile Icon="@Icons.Material.Filled.Payments" Tone="IconTone.Accent" Circle="true" /></Leading>
        <Trailing><Money Amount="180" Signed="true" Tone="MoneyTone.Income" /></Trailing>
    </ListRow>
    <ListRow Title="Dining" Subtitle="Over budget">
        <Leading><IconTile Icon="@Icons.Material.Filled.Restaurant" Tone="IconTone.Error" /></Leading>
        <Trailing><Badge Tone="BadgeTone.Error">Over</Badge></Trailing>
    </ListRow>

    <SectionHeader Title="Progress" />
    <div class="gallery-stack">
        <ProgressBar Percent="93" Label="Groceries" ValueText="£420 of £450" />
        <ProgressBar Percent="173" Label="Dining" ValueText="£260 of £150" />
        <ProgressBar Percent="0" Label="Empty" />
    </div>

    <SectionHeader Title="Badges" />
    <div class="gallery-row">
        <Badge>Neutral</Badge>
        <Badge Tone="BadgeTone.Accent">Default</Badge>
        <Badge Tone="BadgeTone.Error">High</Badge>
        <Badge Tone="BadgeTone.Warn">Medium</Badge>
    </div>

    <SectionHeader Title="Segmented control" />
    <div class="gallery-stack">
        <SegmentedControl T="string" AriaLabel="State example" Segments="segments" Value="@selected" ValueChanged="@(v => selected = v)" />
        <SegmentedControl T="string" AriaLabel="Link example" Segments="linkSegments" Value="@("a")" />
    </div>

    <SectionHeader Title="Empty state" />
    <EmptyState Icon="@Icons.Material.Filled.Receipt" Title="No transactions yet" Message="Add your first transaction to see it here.">
        <Actions><MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/dev/gallery">Add transaction</MudButton></Actions>
    </EmptyState>

    <SectionHeader Title="Accounts" />
    <div class="gallery-row">
        @foreach (var item in sampleAccounts)
        {
            <AccountCard Item="item" />
        }
    </div>
    <AccountSelect Accounts="sampleAccounts" @bind-Value="accountId" Label="Paid from" />
    <AccountSelect Accounts="sampleAccounts" @bind-Value="toAccountId" Label="Into (optional)" AllowNone="true" Error="Choose a different account to move money into." />

    <SectionHeader Title="Form controls" />
    <div class="gallery-stack">
        <MoneyInput @bind-Value="amount" />
        <CategorySelect Categories="sampleCategories" @bind-Value="categoryId" Clearable="true" />
        <CurrencySelect Currencies="sampleCurrencies" @bind-Value="currencyId" />
        <EnumSelect TEnum="TransactionTypeEnum" Label="Type" @bind-Value="transactionType" />
        <DateField @bind-Value="date" />
        <ToggleRow Label="Income applies to next month" Description="Count income toward the following month's budget." @bind-Value="toggled" />
        <ColorSwatchPicker @bind-Value="colour" />
    </div>

    <SectionHeader Title="Form shell" />
    <FormShell Title="Transaction" BackHref="/dev/gallery" Model="sampleCategories[0]" OnValidSubmit="OnSubmit" SubmitLabel="Save" PrimaryLabel="Save transaction">
        <MudTextField T="string" Label="Description" Variant="Variant.Outlined" />
        <MoneyInput @bind-Value="amount" />
    </FormShell>
}

@code {
#if DEBUG
    static readonly bool IsDebug = true;
#else
    static readonly bool IsDebug = false;
#endif

    string selected = "all";

    double amount = 34.2;
    int? categoryId = 2;
    int currencyId = 1;
    TransactionTypeEnum transactionType = TransactionTypeEnum.Expense;
    DateTime? date = DateTime.Today;
    bool toggled;
    string? colour = "#FF9A6E";

    static readonly Category[] sampleCategories =
    [
        new() { Id = 1, Name = "Groceries", Type = TransactionTypeEnum.Expense },
        new() { Id = 2, Name = "Dining", Type = TransactionTypeEnum.Expense },
        new() { Id = 3, Name = "Salary", Type = TransactionTypeEnum.Income }
    ];

    int? accountId = 1;
    int? toAccountId;

    static readonly Currency gbp = new() { Id = 1, Code = "GBP", Name = "British Pound", Symbol = "£" };

    static readonly AccountBalance[] sampleAccounts =
    [
        new(new Account { Id = 1, Name = "Everyday", Type = AccountTypeEnum.Current, Color = "#6EA8FF", Currency = gbp }, 1482.40),
        new(new Account { Id = 2, Name = "Visa card", Type = AccountTypeEnum.CreditCard, Color = "#FF9A6E", CreditLimit = 2000, Currency = gbp }, -612.30),
        new(new Account { Id = 3, Name = "Cash wallet", Type = AccountTypeEnum.Cash, Color = "#F0B94E", Currency = gbp }, 45),
        new(new Account { Id = 4, Name = "Rainy day fund", Type = AccountTypeEnum.Savings, Color = "#33D6A6", Currency = gbp }, 3250)
    ];

    static readonly Currency[] sampleCurrencies =
    [
        new() { Id = 1, Code = "GBP", Name = "British Pound", Symbol = "£" },
        new() { Id = 2, Code = "USD", Name = "US Dollar", Symbol = "$" }
    ];

    Task OnSubmit(EditContext context) => Task.CompletedTask;

    static readonly IReadOnlyList<Segment<string>> segments =
    [
        new("all", "All"),
        new("recurring", "Recurring")
    ];

    static readonly IReadOnlyList<Segment<string>> linkSegments =
    [
        new("a", "Monthly", "/dev/gallery"),
        new("b", "Goals", "/dev/gallery")
    ];

    void OnThemeChanged(ThemeMode mode) => Settings.ThemeMode = mode;

    void OnHideChanged(bool hide) => Settings.HideAmounts = hide;
}
