@page "/data/backup-password"
@layout FocusLayout
@using SpendSense.Common.Security
@inject BackupKeys Keys
@inject BackupFlow Backup
@inject IClipboard Clipboard
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

@* ADR 0004: step 1 sets the password, step 2 shows the recovery code once. Nothing is saved until step 1 is done;
   leaving during step 2 keeps the new password and code, which the code's own warning makes clear. *@
@if (recoveryCode is null)
{
    <FormShell Title="@(changing ? "Change backup password" : "Backup password")" BackHref="/settings" Model="model"
               OnValidSubmit="SetPassword" SubmitLabel="Next" Busy="busy">
        <p class="lead">
            Backups are encrypted, so they're safe in iCloud Drive or Google Drive. You'll need this password, or the
            recovery code shown next, to restore a backup on this or another device.
        </p>
        <MudTextField @bind-Value="model.Password" Label="Backup password" InputType="InputType.Password" Variant="Variant.Outlined"
                      HelperText="@($"At least {BackupKeys.MinPasswordLength} characters")" Error="@(passwordError is not null)" ErrorText="@passwordError"
                      Immediate="true" autocomplete="new-password" />
        <MudTextField @bind-Value="model.Confirm" Label="Confirm password" InputType="InputType.Password" Variant="Variant.Outlined"
                      Error="@(confirmError is not null)" ErrorText="@confirmError" Immediate="true" autocomplete="new-password" />
        @if (changing)
        {
            <p class="note">Backups you've already made keep the password and recovery code they were made with.</p>
        }
        <p class="warning" role="note">
            <strong>SpendSense can't reset this password.</strong> If you forget it and lose your recovery code, your
            backups can't be opened by anyone.
        </p>
    </FormShell>
}
else
{
    <FormShell Title="Recovery code" BackHref="/settings" Model="model" OnValidSubmit="Finish"
               SubmitLabel="Done" PrimaryLabel="@(backUpAfter ? "Done, back up now" : "Done")" Busy="busy">
        <p class="lead">If you forget your backup password, this code opens your backups instead. It's only shown now.</p>
        <div class="code-box">
            <p class="code" aria-label="Recovery code">@recoveryCode</p>
            <button type="button" class="copy" @onclick="Copy">Copy</button>
        </div>
        <p class="warning" role="note">
            <strong>Keep it private.</strong> Anyone with this code and a backup file can see your data. Store it somewhere
            separate from your backups, such as a password manager or on paper.
        </p>
        <MudCheckBox T="bool" @bind-Value="saved" Label="I've saved my recovery code" Color="Color.Primary" />
        @if (savedError is not null)
        {
            <p class="error" role="alert">@savedError</p>
        }
    </FormShell>
}

@code {
    sealed class PasswordModel
    {
        public string? Password { get; set; }
        public string? Confirm { get; set; }
    }

    /// <summary><c>backup</c>: reached from "Back up now", so back up once the password is set.</summary>
    [SupplyParameterFromQuery(Name = "then")] public string? Then { get; set; }

    readonly PasswordModel model = new();
    bool changing;
    bool busy;
    string? passwordError;
    string? confirmError;
    string? recoveryCode;
    bool saved;
    string? savedError;

    bool backUpAfter => Then == "backup";

    protected override async Task OnInitializedAsync() => changing = await Keys.IsSetUp();

    async Task SetPassword()
    {
        passwordError = model.Password is not { Length: >= BackupKeys.MinPasswordLength }
            ? $"Use at least {BackupKeys.MinPasswordLength} characters."
            : null;
        confirmError = passwordError is null && model.Confirm != model.Password ? "The passwords don't match." : null;
        if (passwordError is not null || confirmError is not null)
            return;

        busy = true;
        try
        {
            recoveryCode = await Keys.SetPassword(model.Password!);
        }
        finally
        {
            busy = false;
            // Don't keep the password in memory longer than needed.
            model.Password = model.Confirm = null;
        }
    }

    async Task Copy()
    {
        await Clipboard.SetTextAsync(recoveryCode);
        Snackbar.Add("Recovery code copied.", Severity.Normal);
    }

    async Task Finish()
    {
        if (!saved)
        {
            savedError = "Save your recovery code first: it's the only way into your backups if you forget the password.";
            return;
        }

        busy = true;
        try
        {
            if (backUpAfter)
                await Backup.BackUp();
        }
        finally
        {
            busy = false;
        }
        Navigation.NavigateTo("/settings");
    }
}
