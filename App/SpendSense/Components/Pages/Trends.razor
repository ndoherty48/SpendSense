@page "/trends"
@implements IDisposable
@using Microsoft.EntityFrameworkCore
@using SpendSense.Common.Data
@using SpendSense.Common.Models
@using SpendSense.Common.Models.Enums
@using SpendSense.Common.Services
@using SpendSense.Common.Theming
@inject SpendSenseDbContext Db
@inject ThemeService Theme

<PageHeader Title="Trends" />

<SegmentedControl T="int" Segments="ranges" Value="selectedRange" ValueChanged="OnRangeChanged" AriaLabel="Period" />

@if (!totalSeries.Any() && !categorySeries.Any())
{
    <EmptyState Icon="@Icons.Material.Filled.TrendingUp"
                Title="No spending to chart yet"
                Message="Once you record some expenses, your monthly trends will show up here." />
}

@if (totalSeries.Any())
{
    <SectionHeader Title="Total spending" />
    <div class="card">
        <MudChart ChartType="ChartType.Line" ChartSeries="@totalSeries" ChartLabels="@monthLabels" ChartOptions="ChartTheme.Options(Theme.ResolvedDark)" Width="100%" Height="300px" T="double" />
    </div>
}

@if (categorySeries.Any())
{
    <SectionHeader Title="Spending by category" />
    <div class="card">
        <MudChart ChartType="ChartType.Bar" ChartSeries="@categorySeries" ChartLabels="@monthLabels" ChartOptions="ChartTheme.Options(Theme.ResolvedDark)" Width="100%" Height="300px" T="double" />
    </div>
}

@code {
    protected override void OnInitialized() => Theme.Changed += OnThemeChanged;

    // ThemeService can raise Changed from the native UI thread; the chart palette depends on it.
    void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Theme.Changed -= OnThemeChanged;

    static readonly IReadOnlyList<Segment<int>> ranges =
    [
        new(3, "3 months"),
        new(6, "6 months"),
        new(12, "12 months")
    ];

    int selectedRange = 6;
    List<ChartSeries<double>> totalSeries = [];
    List<ChartSeries<double>> categorySeries = [];
    string[] monthLabels = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task OnRangeChanged(int value)
    {
        selectedRange = value;
        await LoadData();
    }

    async Task LoadData()
    {
        var now = DateTime.Now;
        var months = Enumerable.Range(0, selectedRange)
            .Select(i => new DateTime(now.Year, now.Month, 1).AddMonths(-(selectedRange - 1) + i))
            .ToList();

        monthLabels = months.Select(m => m.ToString("MMM yy")).ToArray();

        var transactions = await Db.Transactions
            .Include(t => t.Category)
            .Where(t => t.TransactionType == TransactionTypeEnum.Expense && t.TransactionDate >= months.First())
            .ToListAsync();

        totalSeries =
        [
            new ChartSeries<double>
            {
                Name = "Total Spending",
                Data = months.Select(m =>
                    transactions.Where(t => t.TransactionDate.Year == m.Year && t.TransactionDate.Month == m.Month)
                        .Sum(t => t.Amount)
                ).ToArray()
            }
        ];

        var categories = transactions
            .Where(t => t.Category is not null)
            .Select(t => t.Category!.Name)
            .Distinct()
            .OrderBy(c => c)
            .ToList();

        categorySeries = categories.Select(cat => new ChartSeries<double>
        {
            Name = cat,
            Data = months.Select(m =>
                transactions.Where(t => t.Category?.Name == cat && t.TransactionDate.Year == m.Year && t.TransactionDate.Month == m.Month)
                    .Sum(t => t.Amount)
            ).ToArray()
        }).ToList();
    }
}
