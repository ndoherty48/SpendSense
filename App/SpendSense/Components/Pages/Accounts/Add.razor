@page "/accounts/add"
@layout FocusLayout
@using SpendSense.Common.Data.Repositories
@using SpendSense.Common.Models
@using SpendSense.Common.Models.Enums
@inject AccountRepository AccountRepo
@inject CurrencyRepository CurrencyRepo
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

@if (ready)
{
    <AccountForm Title="New account" Model="model" Currencies="currencies" ParentOptions="parents" BackHref="/accounts" ShowBalance="true" SubmitLabel="Add account" OnSubmit="Submit" />
}

@code {
    Account model = new()
    {
        Name = "",
        Type = AccountTypeEnum.Current,
        Color = AccountVisuals.DefaultColor(AccountTypeEnum.Current),
        IncludeInAvailable = true
    };
    IReadOnlyCollection<Currency> currencies = [];
    IReadOnlyList<Account> parents = [];
    bool ready;

    /// <summary>Start as a pot inside this account (an account page's "Add pot").</summary>
    [SupplyParameterFromQuery(Name = "parent")] public int? ParentParam { get; set; }

    protected override async Task OnInitializedAsync()
    {
        currencies = await CurrencyRepo.GetAll();
        parents = await AccountRepo.GetParentOptions();
        if (currencies.FirstOrDefault(c => c.IsDefault) is { } defaultCurrency)
            model.CurrencyId = defaultCurrency.Id;
        if (parents.FirstOrDefault(p => p.Id == ParentParam) is { } parent)
        {
            // A new pot: savings by default, in the parent's currency.
            model.ParentAccountId = parent.Id;
            model.CurrencyId = parent.CurrencyId;
            model.Type = AccountTypeEnum.Savings;
            model.Color = AccountVisuals.DefaultColor(AccountTypeEnum.Savings);
            model.IncludeInAvailable = false;
        }
        // The first open account becomes the default automatically.
        model.IsDefault = await AccountRepo.GetDefault() is null;
        ready = true;
    }

    async Task Submit()
    {
        if (await AccountRepo.NameExists(model.Name))
        {
            Snackbar.Add($"An account called '{model.Name}' already exists.", Severity.Error);
            return;
        }
        await AccountRepo.Add(model);
        Navigation.NavigateTo(model.ParentAccountId is { } parentId ? $"/accounts/{parentId}" : "/accounts");
    }
}
