@using SpendSense.Common.Models.Enums
@using SpendSense.Common.Services
@inject SettingsService Settings

<div class="@(Nested ? "nested" : null)">
<ListRow Title="@Item.Account.Name" Subtitle="@Subtitle" Href="@($"/accounts/{Item.Account.Id}")">
    <Leading><IconTile Icon="@AccountVisuals.Icon(Item.Account.Type)" Color="@Item.Account.Color" /></Leading>
    <Trailing>
        @if (Item.IsCard)
        {
            <span class="owed"><Money Amount="Item.Owed" Symbol="@Item.Symbol" /><span class="caption">owed</span></span>
        }
        else
        {
            <Money Amount="Item.Balance" Symbol="@Item.Symbol" Tone="@(Item.Balance < 0 ? MoneyTone.Error : MoneyTone.Neutral)" />
        }
        <svg class="chevron" viewBox="0 0 24 24" fill="currentColor" focusable="false" aria-hidden="true">@((MarkupString)Icons.Material.Filled.ChevronRight)</svg>
    </Trailing>
</ListRow>
</div>

@code {
    [Parameter, EditorRequired] public AccountBalance Item { get; set; } = default!;

    /// <summary>A pot shown under its parent: indented, with "Pot" as its label.</summary>
    [Parameter] public bool Nested { get; set; }

    /// <summary>For an account with pots: the combined balance, shown in the subtitle.</summary>
    [Parameter] public double? TotalWithPots { get; set; }

    string Subtitle
    {
        get
        {
            var account = Item.Account;
            if (Item.AvailableCredit is { } left)
            {
                var hide = Settings.HideAmounts;
                return $"{MoneyFormat.Format(left, Item.Symbol, hide)} of {MoneyFormat.Format(account.CreditLimit ?? 0, Item.Symbol, hide, decimals: 0)} left";
            }

            var parts = new List<string> { Nested ? "Pot" : AccountVisuals.Label(account.Type) };
            if (account.IsDefault)
                parts.Add("Default");
            if (TotalWithPots is { } total)
                parts.Add($"{MoneyFormat.Format(total, Item.Symbol, Settings.HideAmounts)} with pots");
            if (!account.IncludeInAvailable)
                parts.Add("Not counted in Available");
            return string.Join(" · ", parts);
        }
    }
}
