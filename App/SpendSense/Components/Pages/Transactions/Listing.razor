@page "/transactions"
@using SpendSense.Common.Data.Repositories
@using SpendSense.Common.Models
@using SpendSense.Common.Models.Enums
@inject TransactionRepository Repository
@inject CategoryRepository CategoryRepo
@inject AccountRepository AccountRepo
@inject IDialogService Dialog

<PageHeader Title="Transactions" />

<div class="filters">
    <MudTextField Value="searchText" ValueChanged="OnSearchChanged" T="string" Immediate="true" Label="Search" Placeholder="Description or notes"
                  Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="search" />
    <CategorySelect Categories="categories" Value="filterCategory" ValueChanged="OnCategoryChanged" Clearable="true" />
    <MudSelect Value="filterType" ValueChanged="OnTypeChanged" T="TransactionTypeEnum?" Label="Type" Clearable="true" Variant="Variant.Outlined">
        <MudSelectItem Value="@((TransactionTypeEnum?)TransactionTypeEnum.Income)">Income</MudSelectItem>
        <MudSelectItem Value="@((TransactionTypeEnum?)TransactionTypeEnum.Expense)">Expense</MudSelectItem>
        <MudSelectItem Value="@((TransactionTypeEnum?)TransactionTypeEnum.Savings)">Savings</MudSelectItem>
        <MudSelectItem Value="@((TransactionTypeEnum?)TransactionTypeEnum.Transfer)">Transfer</MudSelectItem>
    </MudSelect>
    <MudSelect Value="filterAccount" ValueChanged="OnAccountChanged" T="int?" Label="Account" Clearable="true" Variant="Variant.Outlined" Class="account">
        @foreach (var account in accounts)
        {
            <MudSelectItem Value="@((int?)account.Id)">@account.Name@(account.IsArchived ? " (archived)" : "")</MudSelectItem>
        }
    </MudSelect>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" aria-label="Loading transactions" />
}
else if (!Groups.Any())
{
    var filtering = !string.IsNullOrWhiteSpace(searchText) || filterCategory.HasValue || filterType.HasValue || filterAccount.HasValue;
    <EmptyState Icon="@Icons.Material.Filled.Receipt"
                Title="@(filtering ? "No matching transactions" : "No transactions yet")"
                Message="@(filtering ? "Try a different search or clear a filter." : "Tap + to add your first transaction.")" />
}
else
{
    @foreach (var group in Groups)
    {
        <h2 class="day">@DayLabel(group.Key)</h2>
        @foreach (var t in group)
        {
            <div class="item">
                <ListRow Title="@t.Description" Subtitle="@TransactionVisuals.Subtitle(t)" Href="@($"/transactions/edit/{t.Id}")">
                    <Leading><IconTile Icon="@TransactionVisuals.Icon(t.TransactionType)" Tone="@TransactionVisuals.Tone(t.TransactionType)" Circle="true" /></Leading>
                    <Trailing><Money Amount="@TransactionVisuals.Amount(t)" Symbol="@(t.Currency?.Symbol ?? "£")" Signed="@TransactionVisuals.Signed(t)" Tone="@TransactionVisuals.AmountTone(t)" /></Trailing>
                </ListRow>
                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" OnClick="() => Delete(t)" aria-label="@($"Delete {t.Description}")" />
            </div>
        }
    }
}

@code {
    IEnumerable<IGrouping<DateTime, Transaction>> Groups =>
        (FilteredElements ?? [])
            .OrderByDescending(t => t.TransactionDate)
            .ThenByDescending(t => t.Id)
            .GroupBy(t => t.TransactionDate.Date);

    static string DayLabel(DateTime day) =>
        day == DateTime.Today ? "Today"
        : day == DateTime.Today.AddDays(-1) ? "Yesterday"
        : day.ToString("ddd d MMM yyyy");

    IReadOnlyCollection<Transaction>? allElements;
    IEnumerable<Transaction>? FilteredElements;
    IReadOnlyCollection<Category> categories = [];
    IReadOnlyCollection<Account> accounts = [];
    bool _loading => allElements is null;
    string searchText = "";
    int? filterCategory;
    TransactionTypeEnum? filterType;
    int? filterAccount;

    /// <summary>Open filtered to one account (an account page's "See all").</summary>
    [SupplyParameterFromQuery(Name = "account")] public int? AccountParam { get; set; }

    protected override async Task OnInitializedAsync()
    {
        allElements = await Repository.GetAll();
        categories = await CategoryRepo.GetAll();
        accounts = await AccountRepo.GetAll();
        filterAccount = AccountParam;
        ApplyFilters();
    }

    void ApplyFilters()
    {
        if (allElements is null) return;
        var filtered = allElements.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchText))
            filtered = filtered.Where(t => t.Description.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || (t.Notes?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false));
        if (filterCategory.HasValue)
            filtered = filtered.Where(t => t.CategoryId == filterCategory.Value);
        if (filterType.HasValue)
            filtered = filtered.Where(t => t.TransactionType == filterType.Value);
        if (filterAccount.HasValue)
            filtered = filtered.Where(t => t.AccountId == filterAccount.Value || t.ToAccountId == filterAccount.Value);

        FilteredElements = filtered.ToList();
    }

    void OnSearchChanged(string value) { searchText = value; ApplyFilters(); }
    void OnCategoryChanged(int? value) { filterCategory = value; ApplyFilters(); }
    void OnTypeChanged(TransactionTypeEnum? value) { filterType = value; ApplyFilters(); }
    void OnAccountChanged(int? value) { filterAccount = value; ApplyFilters(); }

    async Task Delete(Transaction transaction)
    {
        var result = await Dialog.ShowMessageBoxAsync("Delete", $"Delete transaction '{transaction.Description}'?", "Yes", "Cancel");
        if (result != true) return;
        await Repository.Delete(transaction);
        allElements = await Repository.GetAll();
        ApplyFilters();
    }
}
