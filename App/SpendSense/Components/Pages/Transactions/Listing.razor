@page "/transactions"
@using SpendSense.Common.Data.Repositories
@using SpendSense.Common.Models
@inject TransactionRepository Repository

<h1>Transactions</h1>
<MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/transactions/add">Add</MudButton>

<MudTable Items="@Elements" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@_loading" LoadingProgressColor="Color.Info">
    <HeaderContent>
        <MudTh>Date</MudTh>
        <MudTh>Description</MudTh>
        <MudTh>Category</MudTh>
        <MudTh>Type</MudTh>
        <MudTh>Amount</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Date">@context.TransactionDate.ToString("dd MMM yyyy")</MudTd>
        <MudTd DataLabel="Description">@context.Description</MudTd>
        <MudTd DataLabel="Category">@context.Category?.Name</MudTd>
        <MudTd DataLabel="Type">
            <MudChip T="string" Color="@(context.TransactionType == SpendSense.Common.Models.Enums.TransactionTypeEnum.Income ? Color.Success : Color.Error)" Size="Size.Small">
                @context.TransactionType
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Amount">@context.Currency?.Symbol@context.Amount.ToString("F2")</MudTd>
    </RowTemplate>
</MudTable>

@code {
    IEnumerable<Transaction>? Elements;
    bool _loading => Elements is null;

    protected override async Task OnInitializedAsync()
    {
        Elements = await Repository.GetAll();
    }
}
