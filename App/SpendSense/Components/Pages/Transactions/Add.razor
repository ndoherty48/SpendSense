@page "/transactions/add"
@using SpendSense.Common.Data.Repositories
@using SpendSense.Common.Models
@using SpendSense.Common.Models.Enums
@inject TransactionRepository TransactionRepo
@inject CategoryRepository CategoryRepo
@inject CurrencyRepository CurrencyRepo
@inject NavigationManager Navigation

<EditForm Model="@model" OnValidSubmit="OnValidSubmit">
<MudGrid>
    <MudItem xs="12" sm="7">
        <MudCard>
            <MudCardContent>
                <MudTextField 
                    Label="Description" 
                    @bind-Value="model.Description" 
                    For="@(() => model.Description)"
                />
                <MudSelect 
                    Label="Type" 
                    Class="mt-3"
                    @bind-Value="model.TransactionType"
                >
                    @foreach (var type in Enum.GetValues<TransactionTypeEnum>())
                    {
                        <MudSelectItem Value="type">@type</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect 
                    Label="Category" 
                    Class="mt-3"
                    @bind-Value="model.CategoryId"
                >
                    @foreach (var cat in categories)
                    {
                        <MudSelectItem Value="@((int?)cat.Id)">@cat.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField 
                    Label="Amount" 
                    Class="mt-3"
                    @bind-Value="model.Amount" 
                    For="@(() => model.Amount)"
                    Min="0.01"
                />
                <MudSelect 
                    Label="Currency" 
                    Class="mt-3"
                    @bind-Value="model.CurrencyId"
                >
                    @foreach (var cur in currencies)
                    {
                        <MudSelectItem Value="cur.Id">@cur.Code - @cur.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudDatePicker 
                    Label="Date" 
                    Class="mt-3"
                    @bind-Date="transactionDate"
                />
                <MudTextField 
                    Label="Notes" 
                    Class="mt-3"
                    @bind-Value="model.Notes"
                    Lines="3"
                />
            </MudCardContent>
            <MudCardActions>
                <MudButton 
                    ButtonType="ButtonType.Submit" 
                    Variant="Variant.Filled" 
                    Color="Color.Primary" 
                    Class="ml-auto"
                >Add</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="5">
        <MudPaper Class="pa-4 mud-height-full">
            <MudText Typo="Typo.subtitle2">Validation Summary</MudText>
            @if (success)
            {
                <MudText Color="Color.Success">Success</MudText>
            }
            else
            {
                <MudText Color="@Color.Error">
                    <ValidationSummary />
                </MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>
</EditForm>

@code {
    Transaction model = new()
    {
        Description = "",
        Amount = 0,
        TransactionType = TransactionTypeEnum.Expense,
        TransactionDate = DateTime.Today
    };
    DateTime? transactionDate = DateTime.Today;
    IReadOnlyCollection<Category> categories = [];
    IReadOnlyCollection<Currency> currencies = [];
    bool success;

    protected override async Task OnInitializedAsync()
    {
        categories = await CategoryRepo.GetAll();
        currencies = await CurrencyRepo.GetAll();
        var defaultCurrency = currencies.FirstOrDefault(c => c.IsDefault);
        if (defaultCurrency is not null)
            model.CurrencyId = defaultCurrency.Id;
    }

    async Task OnValidSubmit(EditContext context)
    {
        model.TransactionDate = transactionDate ?? DateTime.Today;
        await TransactionRepo.Add(model);
        success = true;
        Navigation.NavigateTo("/transactions");
    }
}
