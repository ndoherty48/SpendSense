@using Microsoft.EntityFrameworkCore
@using SpendSense.Common.Models
@using SpendSense.Common.Models.Enums
@inject SpendSense.Common.Data.SpendSenseDbContext Db

<EditForm Model="@Model" OnValidSubmit="OnValidSubmit">
<MudGrid>
    <MudItem xs="12" sm="7">
        <MudCard>
            <MudCardContent>
                <MudTextField
                    Label="Description"
                    Value="Model.Description"
                    ValueChanged="OnDescriptionChanged"
                    T="string"
                    DebounceInterval="500"
                    Immediate="true"
                />
                <MudSelect
                    Label="Type"
                    Class="mt-3"
                    @bind-Value="Model.TransactionType"
                >
                    @foreach (var type in Enum.GetValues<TransactionTypeEnum>())
                    {
                        <MudSelectItem Value="type">@type</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect
                    Label="Category"
                    Class="mt-3"
                    @bind-Value="Model.CategoryId"
                >
                    @foreach (var cat in Categories)
                    {
                        <MudSelectItem Value="@((int?)cat.Id)">@cat.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField
                    Label="Amount"
                    Class="mt-3"
                    @bind-Value="Model.Amount"
                    For="@(() => Model.Amount)"
                    Min="0.01"
                />
                <MudSelect
                    Label="Currency"
                    Class="mt-3"
                    @bind-Value="Model.CurrencyId"
                >
                    @foreach (var cur in Currencies)
                    {
                        <MudSelectItem Value="cur.Id">@cur.Code - @cur.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudDatePicker
                    Label="Date"
                    Class="mt-3"
                    @bind-Date="transactionDate"
                />
                <MudTextField
                    Label="Notes"
                    Class="mt-3"
                    @bind-Value="Model.Notes"
                    Lines="3"
                />
            </MudCardContent>
            <MudCardActions>
                <MudButton
                    ButtonType="ButtonType.Submit"
                    Variant="Variant.Filled"
                    Color="Color.Primary"
                    Class="ml-auto"
                >@SubmitLabel</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
    @if (ShowValidationSummary)
    {
        <MudItem xs="12" sm="5">
            <MudPaper Class="pa-4 mud-height-full">
                <MudText Typo="Typo.subtitle2">Validation Summary</MudText>
                <MudText Color="@Color.Error">
                    <ValidationSummary />
                </MudText>
            </MudPaper>
        </MudItem>
    }
</MudGrid>
</EditForm>

@code {
    [Parameter, EditorRequired] public Transaction Model { get; set; } = default!;

    [Parameter, EditorRequired] public IReadOnlyCollection<Category> Categories { get; set; } = [];

    [Parameter, EditorRequired] public IReadOnlyCollection<Currency> Currencies { get; set; } = [];

    /// <summary>Pre-select the category most used for similar descriptions (Add only).</summary>
    [Parameter] public bool SuggestCategory { get; set; }

    [Parameter] public bool ShowValidationSummary { get; set; }

    [Parameter] public string SubmitLabel { get; set; } = "Save";

    /// <summary>Called after the model's date has been applied; the page persists the transaction.</summary>
    [Parameter] public EventCallback OnSubmit { get; set; }

    DateTime? transactionDate;

    protected override void OnInitialized() => transactionDate = Model.TransactionDate;

    async Task OnValidSubmit(EditContext context)
    {
        Model.TransactionDate = transactionDate ?? DateTime.Today;
        await OnSubmit.InvokeAsync();
    }

    async Task OnDescriptionChanged(string value)
    {
        Model.Description = value;
        if (!SuggestCategory || string.IsNullOrWhiteSpace(value) || value.Length < 3) return;

        var suggestion = await Db.Transactions
            .Where(t => t.Description.Contains(value) && t.CategoryId != null)
            .GroupBy(t => t.CategoryId)
            .OrderByDescending(g => g.Count())
            .Select(g => g.Key)
            .FirstOrDefaultAsync();

        if (suggestion.HasValue && Model.CategoryId != suggestion.Value)
        {
            Model.CategoryId = suggestion.Value;
            StateHasChanged();
        }
    }
}
