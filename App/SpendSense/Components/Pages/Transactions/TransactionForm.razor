@using Microsoft.EntityFrameworkCore
@using SpendSense.Common.Models
@using SpendSense.Common.Models.Enums
@using SpendSense.Common.Services
@inject SpendSense.Common.Data.SpendSenseDbContext Db
@inject SettingsService Settings

<FormShell Title="@Title" BackHref="@BackHref" Model="Model" OnValidSubmit="OnValidSubmit" SubmitLabel="Save" PrimaryLabel="@PrimaryText">
    <SegmentedControl T="TransactionTypeEnum" Segments="types" Value="Model.TransactionType" ValueChanged="OnTypeChanged" AriaLabel="Transaction type" />

    <MoneyInput @bind-Value="Model.Amount" Symbol="@CurrentSymbol" Min="0.01" />

    <AccountFields Model="Model" Accounts="Accounts" Error="@accountError" OnChanged="() => accountError = null" />
    @if (Preview is { } preview)
    {
        <p class="preview">@preview</p>
    }

    <MudTextField Label="@(Model.TransactionType == TransactionTypeEnum.Transfer ? "Description (optional)" : "Description")"
                  Value="Model.Description"
                  ValueChanged="OnDescriptionChanged"
                  T="string"
                  DebounceInterval="500"
                  Immediate="true"
                  Variant="Variant.Outlined" />

    @if (Model.TransactionType != TransactionTypeEnum.Transfer)
    {
        <CategorySelect Categories="Categories" @bind-Value="Model.CategoryId" />
    }

    <DateField @bind-Value="transactionDate" />

    <MudTextField Label="Notes" @bind-Value="Model.Notes" Lines="3" Variant="Variant.Outlined" />

    @if (Model.TransactionType == TransactionTypeEnum.Transfer)
    {
        <p class="note">Transfers move money between your own accounts. They don't count as income, spending or savings, so budgets and trends aren't affected.</p>
    }
</FormShell>

@code {
    [Parameter, EditorRequired] public Transaction Model { get; set; } = default!;

    [Parameter, EditorRequired] public IReadOnlyCollection<Category> Categories { get; set; } = [];

    /// <summary>Accounts to offer, with balances: open accounts plus any archived one the transaction already uses.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<AccountBalance> Accounts { get; set; } = [];

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string BackHref { get; set; } = "/transactions";

    /// <summary>Pre-select the category most used for similar descriptions (Add only).</summary>
    [Parameter] public bool SuggestCategory { get; set; }

    /// <summary>Show what a transfer leaves in each account (Add only; on Edit the balances already include it).</summary>
    [Parameter] public bool ShowPreview { get; set; }

    /// <summary>Label for the full-width button, e.g. "Add transaction".</summary>
    [Parameter] public string SubmitLabel { get; set; } = "Save";

    /// <summary>Called after the date, currency and accounts have been applied; the page persists the transaction.</summary>
    [Parameter] public EventCallback OnSubmit { get; set; }

    static readonly IReadOnlyList<Segment<TransactionTypeEnum>> types =
    [
        new(TransactionTypeEnum.Expense, "Expense"),
        new(TransactionTypeEnum.Income, "Income"),
        new(TransactionTypeEnum.Savings, "Savings"),
        new(TransactionTypeEnum.Transfer, "Transfer")
    ];

    DateTime? transactionDate;
    string? accountError;

    AccountBalance? From => AccountFields.Find(Accounts, Model.AccountId);

    AccountBalance? To => AccountFields.Find(Accounts, Model.ToAccountId);

    // The currency follows the account.
    string CurrentSymbol => From?.Symbol ?? "£";

    string PrimaryText => Model.TransactionType == TransactionTypeEnum.Transfer && SubmitLabel != "Save" ? "Transfer" : SubmitLabel;

    string? Preview
    {
        get
        {
            if (!ShowPreview || Model.TransactionType != TransactionTypeEnum.Transfer || From is not { } from || To is not { } to || Model.Amount <= 0)
                return null;
            return $"After: {Describe(from, from.Balance - Model.Amount)} · {Describe(to, to.Balance + Model.Amount)}";
        }
    }

    string Describe(AccountBalance item, double balance)
    {
        var hide = Settings.HideAmounts;
        return item.IsCard
            ? $"{item.Account.Name} owes {MoneyFormat.Format(Math.Max(0, -balance), item.Symbol, hide)}"
            : $"{item.Account.Name} {MoneyFormat.Format(balance, item.Symbol, hide)}";
    }

    protected override void OnInitialized() => transactionDate = Model.TransactionDate;

    void OnTypeChanged(TransactionTypeEnum type)
    {
        Model.TransactionType = type;
        accountError = null;
    }

    async Task OnValidSubmit(EditContext context)
    {
        accountError = AccountFields.Validate(Model, Accounts);
        if (accountError is not null)
            return;

        Model.TransactionDate = transactionDate ?? DateTime.Today;
        Model.CurrencyId = From!.Account.CurrencyId;
        AccountFields.Normalise(Model);
        if (Model.TransactionType == TransactionTypeEnum.Transfer)
        {
            Model.CategoryId = null;
            if (string.IsNullOrWhiteSpace(Model.Description))
                Model.Description = $"Transfer to {To!.Account.Name}";
        }
        await OnSubmit.InvokeAsync();
    }

    async Task OnDescriptionChanged(string value)
    {
        Model.Description = value;
        if (!SuggestCategory || Model.TransactionType == TransactionTypeEnum.Transfer || string.IsNullOrWhiteSpace(value) || value.Length < 3) return;

        var suggestion = await Db.Transactions
            .Where(t => t.Description.Contains(value) && t.CategoryId != null)
            .GroupBy(t => t.CategoryId)
            .OrderByDescending(g => g.Count())
            .Select(g => g.Key)
            .FirstOrDefaultAsync();

        if (suggestion.HasValue && Model.CategoryId != suggestion.Value)
        {
            Model.CategoryId = suggestion.Value;
            StateHasChanged();
        }
    }
}
