@page "/monthly-budgets/edit/{Id:int}"
@using SpendSense.Common.Data.Repositories
@using SpendSense.Common.Models
@inject MonthlyBudgetRepository BudgetRepo
@inject CategoryRepository CategoryRepo
@inject CurrencyRepository CurrencyRepo
@inject NavigationManager Navigation

@if (model is null)
{
    <MudText>Loading...</MudText>
}
else
{
<EditForm Model="@model" OnValidSubmit="OnValidSubmit">
<DataAnnotationsValidator/>
<MudGrid>
    <MudItem xs="12" sm="7">
        <MudCard>
            <MudCardContent>
                <MudNumericField Label="Year" @bind-Value="model.Year" For="@(() => model.Year)" Min="2020" Max="2100" />
                <MudNumericField Label="Month" Class="mt-3" @bind-Value="model.Month" For="@(() => model.Month)" Min="1" Max="12" />
                <MudSelect Label="Category" Class="mt-3" @bind-Value="model.CategoryId">
                    @foreach (var cat in categories)
                    {
                        <MudSelectItem Value="cat.Id">@cat.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField Label="Budgeted Amount" Class="mt-3" @bind-Value="model.BudgetedAmount" For="@(() => model.BudgetedAmount)" Min="0.01" />
                <MudSelect Label="Currency" Class="mt-3" @bind-Value="model.CurrencyId">
                    @foreach (var cur in currencies)
                    {
                        <MudSelectItem Value="cur.Id">@cur.Code - @cur.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudCardContent>
            <MudCardActions>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto">Save</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>
</EditForm>
}

@code {
    [Parameter] public int Id { get; set; }
    MonthlyBudget? model;
    IReadOnlyCollection<Category> categories = [];
    IReadOnlyCollection<Currency> currencies = [];

    protected override async Task OnInitializedAsync()
    {
        model = await BudgetRepo.GetById(Id);
        categories = await CategoryRepo.GetAll();
        currencies = await CurrencyRepo.GetAll();
    }

    async Task OnValidSubmit(EditContext context)
    {
        await BudgetRepo.Update(model!);
        Navigation.NavigateTo("/monthly-budgets");
    }
}
