@page "/monthly-budgets/edit/{Id:int}"
@layout FocusLayout
@using SpendSense.Common.Data.Repositories
@using SpendSense.Common.Models
@inject MonthlyBudgetRepository BudgetRepo
@inject CategoryRepository CategoryRepo
@inject CurrencyRepository CurrencyRepo
@inject NavigationManager Navigation

@if (model is null)
{
    <MudText>Loading...</MudText>
}
else
{
    <BudgetForm Title="Edit budget" Model="model" Categories="categories" Currencies="currencies" OnSubmit="Submit" />
}

@code {
    [Parameter] public int Id { get; set; }
    MonthlyBudget? model;
    IReadOnlyCollection<Category> categories = [];
    IReadOnlyCollection<Currency> currencies = [];

    protected override async Task OnInitializedAsync()
    {
        model = await BudgetRepo.GetById(Id);
        categories = await CategoryRepo.GetAll();
        currencies = await CurrencyRepo.GetAll();
    }

    async Task Submit()
    {
        await BudgetRepo.Update(model!);
        Navigation.NavigateTo("/monthly-budgets");
    }
}
