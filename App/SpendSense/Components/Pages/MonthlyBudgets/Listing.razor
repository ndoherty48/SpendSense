@page "/monthly-budgets"
@using SpendSense.Common.Data.Repositories
@using SpendSense.Common.Models
@inject MonthlyBudgetRepository Repository
@inject IDialogService Dialog

<PageHeader Title="Monthly budgets">
    <Actions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="CopyToNextMonth" StartIcon="@Icons.Material.Filled.ContentCopy">Copy to next month</MudButton>
    </Actions>
</PageHeader>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading budgets" />
}
else if (!Periods.Any())
{
    <EmptyState Icon="@Icons.Material.Filled.AccountBalanceWallet"
                Title="No budgets yet"
                Message="Tap + to set a spending limit for a category." />
}
else
{
    @foreach (var period in Periods)
    {
        <h2 class="period">@(new DateTime(period.Key.Year, period.Key.Month, 1).ToString("MMMM yyyy"))</h2>
        @foreach (var budget in period)
        {
            <div class="item">
                <ListRow Title="@(budget.Category?.Name ?? "Uncategorised")" Subtitle="@budget.Currency?.Code" Href="@($"/monthly-budgets/edit/{budget.Id}")">
                    <Leading><IconTile Icon="@Icons.Material.Filled.Category" Tone="IconTone.Brand" /></Leading>
                    <Trailing><Money Amount="budget.BudgetedAmount" Symbol="@(budget.Currency?.Symbol ?? "£")" /></Trailing>
                </ListRow>
                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" OnClick="() => Delete(budget)" aria-label="@($"Delete {budget.Category?.Name} budget")" />
            </div>
        }
    }
}

@code {
    IEnumerable<IGrouping<(int Year, int Month), MonthlyBudget>> Periods =>
        (Elements ?? []).GroupBy(b => (b.Year, b.Month)).OrderByDescending(g => g.Key.Year).ThenByDescending(g => g.Key.Month);

    IEnumerable<MonthlyBudget>? Elements;
    bool _loading => Elements is null;

    protected override async Task OnInitializedAsync()
    {
        Elements = await Repository.GetAll();
    }

    async Task Delete(MonthlyBudget budget)
    {
        var result = await Dialog.ShowMessageBoxAsync("Delete", "Delete this monthly budget?", "Yes", "Cancel");
        if (result != true) return;
        await Repository.Delete(budget);
        Elements = await Repository.GetAll();
    }

    async Task CopyToNextMonth()
    {
        var latest = Elements?.FirstOrDefault();
        if (latest is null) return;

        var next = new DateTime(latest.Year, latest.Month, 1).AddMonths(1);

        var count = await Repository.CopyMonth(latest.Year, latest.Month, next.Year, next.Month);
        if (count > 0)
            Elements = await Repository.GetAll();
        else
            await Dialog.ShowMessageBoxAsync("Info", $"Budgets for {next:yyyy-MM} already exist.", "OK");
    }
}
