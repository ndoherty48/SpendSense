@page "/categories/edit/{Id:int}"
@layout FocusLayout
@using SpendSense.Common.Data.Repositories
@using SpendSense.Common.Models
@inject CategoryRepository Repository
@inject NavigationManager Navigation

@if (model is null)
{
    <MudText>Loading...</MudText>
}
else
{
    <CategoryForm Title="Edit category" Model="model" OnSubmit="Submit" />
}

@code {
    [Parameter] public int Id { get; set; }
    Category? model;

    protected override async Task OnInitializedAsync()
    {
        model = await Repository.GetById(Id);
    }

    async Task Submit()
    {
        await Repository.Update(model!);
        Navigation.NavigateTo("/categories");
    }
}
