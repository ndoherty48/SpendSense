@page "/categories/add"
@layout FocusLayout
@using SpendSense.Common.Data.Repositories
@using SpendSense.Common.Models
@using SpendSense.Common.Models.Enums
@inject CategoryRepository Repository
@inject NavigationManager Navigation

<CategoryForm Title="New category" Model="model" SubmitLabel="Add category" OnSubmit="Submit" />

@code {
    Category model = new() { Name = "", Type = TransactionTypeEnum.Expense };

    async Task Submit()
    {
        await Repository.Add(model);
        Navigation.NavigateTo("/categories");
    }
}
