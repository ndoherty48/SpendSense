@page "/categories"
@using SpendSense.Common.Data.Repositories
@using SpendSense.Common.Models
@inject CategoryRepository Repository
@inject IDialogService Dialog

<PageHeader Title="Categories">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/categories/add" StartIcon="@Icons.Material.Filled.Add">Add</MudButton>
    </Actions>
</PageHeader>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading categories" />
}
else if (!Elements!.Any())
{
    <EmptyState Icon="@Icons.Material.Filled.Label" Title="No categories yet" Message="Add a category to start organising your transactions." />
}
else
{
    @foreach (var category in Elements!)
    {
        <div class="item">
            <ListRow Title="@category.Name" Subtitle="@(string.IsNullOrWhiteSpace(category.Icon) ? category.Type.ToString() : $"{category.Type} · {category.Icon}")" Href="@($"/categories/edit/{category.Id}")">
                <Leading>
                    <span class="swatch" style="@(SafeColor(category.Color) is { } c ? $"--swatch: {c}" : null)" aria-hidden="true"></span>
                </Leading>
            </ListRow>
            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" OnClick="() => Delete(category)" aria-label="@($"Delete {category.Name}")" />
        </div>
    }
}

@code {
    // Category colours are user data; only draw a value that is a valid hex colour.
    static string? SafeColor(string? color) =>
        color is not null && System.Text.RegularExpressions.Regex.IsMatch(color, "^#[0-9A-Fa-f]{3,8}$") ? color : null;

    IEnumerable<Category>? Elements;
    bool _loading => Elements is null;

    protected override async Task OnInitializedAsync()
    {
        Elements = await Repository.GetAll();
    }

    async Task Delete(Category category)
    {
        if (await Repository.HasDependencies(category.Id))
        {
            await Dialog.ShowMessageBoxAsync("Cannot Delete", $"'{category.Name}' is used by transactions, budgets, or goals and cannot be deleted.", "OK");
            return;
        }
        var result = await Dialog.ShowMessageBoxAsync("Delete", $"Delete category '{category.Name}'?", "Yes", "Cancel");
        if (result != true) return;
        await Repository.Delete(category);
        Elements = await Repository.GetAll();
    }
}
