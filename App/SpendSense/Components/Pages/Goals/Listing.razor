@page "/goals"
@using Microsoft.EntityFrameworkCore
@using SpendSense.Common.Data
@using SpendSense.Common.Data.Repositories
@using SpendSense.Common.Models
@using SpendSense.Common.Models.Enums
@inject GoalRepository Repository
@inject SpendSenseDbContext Db
@inject IDialogService Dialog

<PageHeader Title="Goals" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading goals" />
}
else if (!Elements!.Any())
{
    <EmptyState Icon="@Icons.Material.Filled.Flag"
                Title="No goals yet"
                Message="Tap + to set a savings goal and track your progress." />
}
else
{
    <ul class="goals">
        @foreach (var item in Elements!)
        {
            var goal = item.Goal;
            var symbol = goal.Currency?.Symbol ?? "£";
            <li class="goal">
                <div class="goal-head">
                    <a class="goal-name" href="@($"/goals/edit/{goal.Id}")">@goal.Name</a>
                    <span class="badges">
                        <Badge Tone="PriorityTone(goal.Priority)">@goal.Priority</Badge>
                        <Badge Tone="StatusTone(goal.Status)">@goal.Status</Badge>
                    </span>
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" OnClick="() => Delete(goal)" aria-label="@($"Delete {goal.Name}")" />
                </div>
                <div class="goal-amounts">
                    <span>
                        <Money Amount="item.Saved" Symbol="@symbol" />
                        <span class="of">of</span>
                        <Money Amount="goal.TargetAmount" Symbol="@symbol" Tone="MoneyTone.Muted" />
                    </span>
                    <span class="percent">@($"{item.Percentage:0}%")</span>
                </div>
                <ProgressBar Percent="item.Percentage" Label="@goal.Name" ValueText="@($"{item.Percentage:0}% saved")" />
                <div class="goal-meta">
                    @(goal.Category?.Name ?? "No category")@(goal.TargetDate is { } due ? $" · Target {due:MMMM yyyy}" : "")
                </div>
            </li>
        }
    </ul>
}

@code {
    static BadgeTone PriorityTone(PriorityEnum priority) => priority switch
    {
        PriorityEnum.High => BadgeTone.Error,
        PriorityEnum.Medium => BadgeTone.Warn,
        _ => BadgeTone.Neutral
    };

    static BadgeTone StatusTone(StatusEnum status) => status switch
    {
        StatusEnum.Completed => BadgeTone.Accent,
        StatusEnum.Abandoned => BadgeTone.Error,
        _ => BadgeTone.Neutral
    };

    List<GoalProgress>? Elements;
    bool _loading => Elements is null;

    protected override async Task OnInitializedAsync()
    {
        await LoadGoals();
    }

    async Task LoadGoals()
    {
        var goals = await Repository.GetAll();
        Elements = [];
        foreach (var goal in goals)
        {
            double saved = goal.CurrentAmount;
            if (goal.CategoryId.HasValue)
            {
                saved += await Db.Transactions
                    .Where(t => t.CategoryId == goal.CategoryId && t.TransactionType == TransactionTypeEnum.Savings)
                    .SumAsync(t => t.Amount);
            }
            var pct = goal.TargetAmount > 0 ? Math.Min(100, saved / goal.TargetAmount * 100) : 0;
            Elements.Add(new GoalProgress(goal, saved, pct));
        }
    }

    async Task Delete(Goal goal)
    {
        var result = await Dialog.ShowMessageBoxAsync("Delete", $"Delete goal '{goal.Name}'?", "Yes", "Cancel");
        if (result != true) return;
        await Repository.Delete(goal);
        await LoadGoals();
    }

    record GoalProgress(Goal Goal, double Saved, double Percentage);
}
