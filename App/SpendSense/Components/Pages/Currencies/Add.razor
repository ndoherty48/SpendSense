@page "/currencies/add"
@layout FocusLayout
@using SpendSense.Common.Data.Repositories
@using SpendSense.Common.Models
@inject CurrencyRepository Repository
@inject NavigationManager Navigation

<FormShell Title="New currency" BackHref="/currencies" Model="model" OnValidSubmit="OnValidSubmit" SubmitLabel="Save" PrimaryLabel="Add currency">
    <MudTextField Label="Name" @bind-Value="model.Name" For="@(() => model.Name)" Variant="Variant.Outlined" />
    <div class="pair">
        <MudTextField Label="Code" @bind-Value="model.Code" For="@(() => model.Code)" Variant="Variant.Outlined" />
        <MudTextField Label="Symbol" @bind-Value="model.Symbol" For="@(() => model.Symbol)" Variant="Variant.Outlined" />
    </div>
    <MudTextField Label="Exchange rate" @bind-Value="model.ExchangeRate" For="@(() => model.ExchangeRate)" Variant="Variant.Outlined" />
</FormShell>

@code {
    Currency model = new();

    async Task OnValidSubmit(EditContext context)
    {
        await Repository.Add(model);
        Navigation.NavigateTo("/currencies");
    }
}
