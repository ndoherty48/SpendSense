@page "/currencies"
@using SpendSense.Common.Data.Repositories
@using SpendSense.Common.Models
@inject CurrencyRepository Repository
@inject IDialogService Dialog

<PageHeader Title="Currencies">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/currencies/add" StartIcon="@Icons.Material.Filled.Add">Add</MudButton>
    </Actions>
</PageHeader>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading currencies" />
}
else
{
    @foreach (var currency in Elements!)
    {
        <div class="item">
            <ListRow Title="@($"{currency.Code} — {currency.Name}")" Subtitle="@($"Rate {currency.ExchangeRate}")">
                <Leading><span class="symbol" aria-hidden="true">@currency.Symbol</span></Leading>
                <Trailing>
                    @if (currency.IsDefault)
                    {
                        <Badge Tone="BadgeTone.Accent">Default</Badge>
                    }
                    else
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => SetDefault(currency)">Set default</MudButton>
                    }
                </Trailing>
            </ListRow>
            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" OnClick="() => Delete(currency)" aria-label="@($"Delete {currency.Name}")" />
        </div>
    }
}

@code {
    IEnumerable<Currency>? Elements;
    bool _loading => Elements is null;

    protected override async Task OnInitializedAsync()
    {
        Elements = await Repository.GetAll();
    }

    async Task SetDefault(Currency currency)
    {
        await Repository.SetDefault(currency);
        Elements = await Repository.GetAll();
    }

    async Task Delete(Currency currency)
    {
        if (currency.IsDefault)
        {
            await Dialog.ShowMessageBoxAsync("Cannot Delete", "Cannot delete the default currency.", "OK");
            return;
        }
        if (await Repository.HasDependencies(currency.Id))
        {
            await Dialog.ShowMessageBoxAsync("Cannot Delete", $"'{currency.Name}' is used by transactions or budgets and cannot be deleted.", "OK");
            return;
        }
        var result = await Dialog.ShowMessageBoxAsync("Delete", $"Delete currency '{currency.Name}'?", "Yes", "Cancel");
        if (result != true) return;
        await Repository.Delete(currency);
        Elements = await Repository.GetAll();
    }
}
