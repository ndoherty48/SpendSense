@page "/currencies"
@using SpendSense.Common.Data.Repositories
@using SpendSense.Common.Models
@inject CurrencyRepository Repository


<h1>Currencies</h1>
<MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/currencies/add">Add</MudButton>

<MudTable Items="@Elements" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@_loading" LoadingProgressColor="Color.Info">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Code</MudTh>
        <MudTh>Symbol</MudTh>
        <MudTh>Exchange Rate</MudTh>
        <MudTh>Default</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Code">@context.Code</MudTd>
        <MudTd DataLabel="Symbol">@context.Symbol</MudTd>
        <MudTd DataLabel="Exchange Rate">@context.ExchangeRate</MudTd>
        @if(context.IsDefault){
            <MudTd DataLabel="Default"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success"/></MudTd>
        }
        else{
            <MudTd DataLabel="Default"><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => SetDefault(context)">Set Default</MudButton></MudTd>
        }
    </RowTemplate>
</MudTable>

@code{
    public IEnumerable<Currency>? Elements;
    private bool _loading => Elements is null;

    protected override async Task OnInitializedAsync()
    {
        Elements = await Repository.GetAll();
    }

    async Task SetDefault(Currency currency)
    {
        await Repository.SetDefault(currency);
        Elements = await Repository.GetAll();
    }
}