@page "/settings"
@using SpendSense.Common.Services
@inject SettingsService SettingsSvc

<h1>Settings</h1>

<MudCard Class="mt-4">
    <MudCardContent>
        <MudText Typo="Typo.h6">Appearance</MudText>
        <MudSelect Value="themeMode" ValueChanged="OnThemeChanged" T="ThemeMode" Label="Theme" Class="mt-2" Style="max-width: 240px;">
            <MudSelectItem Value="ThemeMode.System">System</MudSelectItem>
            <MudSelectItem Value="ThemeMode.Light">Light</MudSelectItem>
            <MudSelectItem Value="ThemeMode.Dark">Dark</MudSelectItem>
        </MudSelect>

        <MudDivider Class="my-4"/>

        <MudText Typo="Typo.h6">Budget</MudText>
        <MudSwitch Value="incomeAppliesNextMonth" ValueChanged="OnIncomeSettingChanged" Color="Color.Primary" T="bool" Label="Income applies to next month" Class="mt-2"/>
        <MudText Typo="Typo.caption" Class="ml-12">When enabled, income is counted toward the following month's budget (e.g. salary on May 28th funds June).</MudText>

        <MudDivider Class="my-4"/>

        <MudText Typo="Typo.h6">Privacy</MudText>
        <MudSwitch Value="hideAmounts" ValueChanged="OnHideAmountsChanged" Color="Color.Primary" T="bool" Label="Hide amounts" Class="mt-2"/>
        <MudText Typo="Typo.caption" Class="ml-12">Replaces all monetary values with ••• for privacy when showing your screen.</MudText>
    </MudCardContent>
</MudCard>

@code {
    ThemeMode themeMode;
    bool incomeAppliesNextMonth;
    bool hideAmounts;

    protected override void OnInitialized()
    {
        themeMode = SettingsSvc.ThemeMode;
        incomeAppliesNextMonth = SettingsSvc.IncomeAppliesNextMonth;
        hideAmounts = SettingsSvc.HideAmounts;
    }

    void OnThemeChanged(ThemeMode value)
    {
        themeMode = value;
        SettingsSvc.ThemeMode = value;
    }

    void OnIncomeSettingChanged(bool value)
    {
        incomeAppliesNextMonth = value;
        SettingsSvc.IncomeAppliesNextMonth = value;
    }

    void OnHideAmountsChanged(bool value)
    {
        hideAmounts = value;
        SettingsSvc.HideAmounts = value;
    }
}
