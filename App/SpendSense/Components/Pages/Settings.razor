@page "/settings"
@using SpendSense.Common.Services
@using SpendSense.Components.Pages.Data
@inject SettingsService SettingsSvc
@inject BackupFlow Backup
@inject BackupService Backups

<PageHeader Title="Preferences" />

<SectionHeader Title="Appearance" />
<SegmentedControl T="ThemeMode" Segments="themes" Value="themeMode" ValueChanged="OnThemeChanged" AriaLabel="Theme" />

<SectionHeader Title="Budget" />
<div class="group">
    <ToggleRow Label="Income applies to next month"
               Description="Count income toward the following month's budget (e.g. salary on May 28th funds June)."
               Value="incomeAppliesNextMonth"
               ValueChanged="OnIncomeSettingChanged" />
</div>

<SectionHeader Title="Accounts" />
<div class="group">
    <ToggleRow Label="Count available credit"
               Description="Add the credit left on your cards to Available on the dashboard."
               Value="includeCredit"
               ValueChanged="OnIncludeCreditChanged" />
</div>

<SectionHeader Title="Data" />
<div class="group">
    <ListRow Title="Back up now" Subtitle="@LastBackupText" OnClick="BackUp">
        <Leading><IconTile Icon="@Icons.Material.Filled.CloudUpload" Tone="IconTone.Brand" /></Leading>
    </ListRow>
    <ListRow Title="Backup password" Subtitle="@PasswordText" Href="@BackupFlow.PasswordPage">
        <Leading><IconTile Icon="@Icons.Material.Filled.Key" Tone="IconTone.Brand" /></Leading>
    </ListRow>
    <ListRow Title="Restore from backup" Subtitle="Replace this device's data with a backup file" OnClick="Restore">
        <Leading><IconTile Icon="@Icons.Material.Filled.SettingsBackupRestore" Tone="IconTone.Brand" /></Leading>
    </ListRow>
    <ListRow Title="Export transactions (CSV)" Subtitle="For spreadsheets; not encrypted, and can't be restored" OnClick="ExportCsv">
        <Leading><IconTile Icon="@Icons.Material.Filled.TableView" Tone="IconTone.Brand" /></Leading>
    </ListRow>
</div>
<p class="note">Everything stays on this device, encrypted. Backups are encrypted with your backup password: save them somewhere safe, like Files, iCloud or Drive.</p>

<SectionHeader Title="Privacy" />
<div class="group">
    <ToggleRow Label="Hide amounts"
               Description="Replace all monetary values with ••• when showing your screen."
               Value="hideAmounts"
               ValueChanged="OnHideAmountsChanged" />
</div>

@code {
    static readonly IReadOnlyList<Segment<ThemeMode>> themes =
    [
        new(ThemeMode.System, "System"),
        new(ThemeMode.Light, "Light"),
        new(ThemeMode.Dark, "Dark")
    ];

    ThemeMode themeMode;
    bool incomeAppliesNextMonth;
    bool hideAmounts;
    bool includeCredit;

    bool hasPassword;

    protected override async Task OnInitializedAsync()
    {
        themeMode = SettingsSvc.ThemeMode;
        incomeAppliesNextMonth = SettingsSvc.IncomeAppliesNextMonth;
        hideAmounts = SettingsSvc.HideAmounts;
        includeCredit = SettingsSvc.IncludeCreditInAvailable;
        hasPassword = await Backups.HasPassword();
    }

    void OnThemeChanged(ThemeMode value)
    {
        themeMode = value;
        SettingsSvc.ThemeMode = value;
    }

    void OnIncomeSettingChanged(bool value)
    {
        incomeAppliesNextMonth = value;
        SettingsSvc.IncomeAppliesNextMonth = value;
    }

    void OnIncludeCreditChanged(bool value)
    {
        includeCredit = value;
        SettingsSvc.IncludeCreditInAvailable = value;
    }

    bool busy;

    string PasswordText => hasPassword ? "Change it, or get a new recovery code" : "Set when you first back up";

    string LastBackupText => busy ? "Working…"
        : SettingsSvc.LastBackupAt is { } last ? $"Last backup: {last:d MMM yyyy}"
        : "Never backed up";

    // One action at a time: a second tap while the share sheet is opening is ignored.
    async Task Run(Func<Task<bool>> action)
    {
        if (busy) return;
        busy = true;
        try { await action(); }
        finally { busy = false; }
    }

    Task BackUp() => Run(Backup.BackUp);

    Task Restore() => Run(() => Backup.Restore());

    Task ExportCsv() => Run(Backup.ExportCsv);

    void OnHideAmountsChanged(bool value)
    {
        hideAmounts = value;
        SettingsSvc.HideAmounts = value;
    }
}
