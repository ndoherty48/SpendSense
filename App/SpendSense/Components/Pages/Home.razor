@page "/"
@implements IDisposable
@using Microsoft.EntityFrameworkCore
@using SpendSense.Common.Data
@using SpendSense.Common.Models
@using SpendSense.Common.Models.Enums
@using SpendSense.Common.Services
@using SpendSense.Common.Theming
@inject SpendSenseDbContext Db
@inject SettingsService Settings
@inject ThemeService Theme

<PageHeader Title="Dashboard" />

<div class="month-nav">
    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="PreviousMonth" aria-label="Previous month" />
    <span class="month" aria-live="polite">@(new DateTime(year, month, 1).ToString("MMMM yyyy"))</span>
    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="NextMonth" aria-label="Next month" />
</div>

<HeroBalanceCard Label="Balance this month" Amount="balance" Tone="@(balance < 0 ? MoneyTone.Error : MoneyTone.Neutral)">
    <StatTile Label="Income"><Money Amount="totalIncome" /></StatTile>
    <StatTile Label="Expenses"><Money Amount="totalExpenses" /></StatTile>
    <StatTile Label="Savings"><Money Amount="totalSavings" Tone="MoneyTone.Income" /></StatTile>
</HeroBalanceCard>

@if (comparisonText is not null)
{
    <p class="comparison @ComparisonClass">@comparisonText</p>
}

@if (overspendWarnings.Any())
{
    <div class="alert" role="alert">
        <svg class="alert-icon" viewBox="0 0 24 24" fill="currentColor" focusable="false" aria-hidden="true">@((MarkupString)Icons.Material.Filled.Warning)</svg>
        <ul class="alert-list">
            @foreach (var warning in overspendWarnings)
            {
                <li>@warning</li>
            }
        </ul>
    </div>
}

@if (!spendingByCategory.Any() && !recentTransactions.Any())
{
    <EmptyState Icon="@Icons.Material.Filled.Receipt"
                Title="Nothing this month yet"
                Message="Add a transaction to see your spending, budgets and trends here." />
}

@if (spendingByCategory.Any())
{
    <SectionHeader Title="Spending by category" />
    <div class="donut">
        <MudChart ChartType="ChartType.Donut" ChartSeries="@chartData.AsChartDataSet()" ChartLabels="@chartLabels" ChartOptions="ChartTheme.Options(Theme.ResolvedDark)" Width="100%" Height="260px" />
    </div>

    <ul class="categories">
        @foreach (var item in spendingByCategory)
        {
            var overspent = item.Budget > 0 && item.Spent > item.Budget;
            <li class="category">
                <IconTile Icon="@Icons.Material.Filled.Category" Tone="@(overspent ? IconTone.Error : IconTone.Brand)" Size="34" />
                <div class="category-body">
                    <div class="category-head">
                        <span class="category-name">
                            @item.Category
                            @if (overspent)
                            {
                                <svg class="over-icon" viewBox="0 0 24 24" fill="currentColor" focusable="false" aria-hidden="true">@((MarkupString)Icons.Material.Filled.Warning)</svg>
                                <span class="ss-sr-only">Over budget</span>
                            }
                        </span>
                        <span class="category-amounts">
                            <Money Amount="item.Spent" Size="MoneySize.Small" Tone="@(overspent ? MoneyTone.Error : MoneyTone.Neutral)" />
                            @if (item.Budget > 0)
                            {
                                <span class="sep" aria-hidden="true">/</span>
                                <Money Amount="item.Budget" Size="MoneySize.Small" Tone="MoneyTone.Muted" />
                            }
                            else
                            {
                                <span class="no-budget">No budget</span>
                            }
                        </span>
                    </div>
                    @if (item.Budget > 0)
                    {
                        <ProgressBar Percent="@(item.Spent / item.Budget * 100)" Label="@item.Category" ValueText="@($"{item.Spent / item.Budget * 100:0}% of budget")" />
                    }
                </div>
            </li>
        }
    </ul>
}

@if (recentTransactions.Any())
{
    <SectionHeader Title="Recent">
        <Actions><a href="/transactions">See all</a></Actions>
    </SectionHeader>
    <div class="recent">
        @foreach (var t in recentTransactions)
        {
            var income = t.TransactionType == TransactionTypeEnum.Income;
            <ListRow Title="@t.Description" Subtitle="@RecentSubtitle(t)" Href="@($"/transactions/edit/{t.Id}")">
                <Leading><IconTile Icon="@TransactionVisuals.Icon(t.TransactionType)" Tone="@TransactionVisuals.Tone(t.TransactionType)" Circle="true" /></Leading>
                <Trailing><Money Amount="@(income ? t.Amount : -t.Amount)" Signed="true" Tone="@(income ? MoneyTone.Income : MoneyTone.Neutral)" /></Trailing>
            </ListRow>
        }
    </div>
}

@code {
    protected override void OnInitialized() => Theme.Changed += OnThemeChanged;

    // ThemeService can raise Changed from the native UI thread; the chart palette depends on it.
    void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Theme.Changed -= OnThemeChanged;

    string ComparisonClass => comparisonColor == Color.Error ? "is-worse" : comparisonColor == Color.Success ? "is-better" : "";

    static string RecentSubtitle(Transaction t) => $"{t.Category?.Name ?? "Uncategorised"} · {t.TransactionDate:dd MMM}";

    int year;
    int month;
    double totalIncome;
    double totalExpenses;
    double totalSavings;
    double balance;
    List<(string Category, double Spent, double Budget, string? Color)> spendingByCategory = [];
    List<Transaction> recentTransactions = [];
    double[] chartData = [];
    string[] chartLabels = [];
    string? comparisonText;
    Color comparisonColor = Color.Default;
    List<string> overspendWarnings = [];

    protected override async Task OnInitializedAsync()
    {
        year = Settings.ActiveBudgetYear;
        month = Settings.ActiveBudgetMonth;
        await LoadData();
    }

    async Task PreviousMonth()
    {
        if (month == 1) { month = 12; year--; }
        else { month--; }
        Settings.ActiveBudgetYear = year;
        Settings.ActiveBudgetMonth = month;
        await LoadData();
    }

    async Task NextMonth()
    {
        if (month == 12) { month = 1; year++; }
        else { month++; }
        Settings.ActiveBudgetYear = year;
        Settings.ActiveBudgetMonth = month;
        await LoadData();
    }

    async Task LoadData()
    {
        var startOfMonth = new DateTime(year, month, 1);
        var endOfMonth = startOfMonth.AddMonths(1);

        var monthTransactions = await Db.Transactions
            .Include(t => t.Category)
            .Where(t => t.TransactionDate >= startOfMonth && t.TransactionDate < endOfMonth)
            .ToListAsync();

        var budgets = await Db.MonthlyBudgets
            .Include(mb => mb.Category)
            .Where(mb => mb.Year == year && mb.Month == month)
            .ToListAsync();

        // When "income applies to next month" is on, pull income from the previous month
        if (Settings.IncomeAppliesNextMonth)
        {
            var prevStart = startOfMonth.AddMonths(-1);
            var incomeTransactions = await Db.Transactions
                .Where(t => t.TransactionDate >= prevStart && t.TransactionDate < startOfMonth && t.TransactionType == TransactionTypeEnum.Income)
                .ToListAsync();
            totalIncome = incomeTransactions.Sum(t => t.Amount);
        }
        else
        {
            totalIncome = monthTransactions
                .Where(t => t.TransactionType == TransactionTypeEnum.Income)
                .Sum(t => t.Amount);
        }

        totalExpenses = monthTransactions
            .Where(t => t.TransactionType == TransactionTypeEnum.Expense)
            .Sum(t => t.Amount);

        totalSavings = monthTransactions
            .Where(t => t.TransactionType == TransactionTypeEnum.Savings)
            .Sum(t => t.Amount);

        balance = totalIncome - totalExpenses - totalSavings;

        spendingByCategory = monthTransactions
            .Where(t => t.TransactionType == TransactionTypeEnum.Expense && t.Category is not null)
            .GroupBy(t => t.Category!)
            .Select(g => (
                Category: g.Key.Name,
                Spent: g.Sum(t => t.Amount),
                Budget: budgets.FirstOrDefault(b => b.Category?.Name == g.Key.Name)?.BudgetedAmount ?? 0,
                Color: g.Key.Color
            ))
            .OrderByDescending(x => x.Spent)
            .ToList();

        chartData = spendingByCategory.Select(x => x.Spent).ToArray();
        chartLabels = spendingByCategory.Select(x => x.Category).ToArray();

        // Predictive overspend warnings
        overspendWarnings = [];
        var daysElapsed = (DateTime.Now - startOfMonth).Days;
        var daysInMonth = (endOfMonth - startOfMonth).Days;
        if (daysElapsed >= 5)
        {
            foreach (var item in spendingByCategory.Where(x => x.Budget > 0))
            {
                var projected = item.Spent / daysElapsed * daysInMonth;
                if (projected > item.Budget * 1.1)
                {
                    var hide = Settings.HideAmounts;
                    overspendWarnings.Add($"{item.Category}: on track to spend {MoneyFormat.Format(projected, "£", hide, decimals: 0)} (budget {MoneyFormat.Format(item.Budget, "£", hide, decimals: 0)})");
                }
            }
        }

        recentTransactions = await Db.Transactions
            .Include(t => t.Category)
            .Where(t => t.TransactionDate >= startOfMonth && t.TransactionDate < endOfMonth)
            .OrderByDescending(t => t.TransactionDate)
            .Take(10)
            .ToListAsync();

        // Month-over-month comparison
        var compStart = startOfMonth.AddMonths(-1);
        var prevExpenses = await Db.Transactions
            .Where(t => t.TransactionDate >= compStart && t.TransactionDate < startOfMonth && t.TransactionType == TransactionTypeEnum.Expense)
            .SumAsync(t => t.Amount);

        if (prevExpenses > 0)
        {
            var diff = ((totalExpenses - prevExpenses) / prevExpenses) * 100;
            if (Math.Abs(diff) < 1)
            {
                comparisonText = "Spending is about the same as last month";
                comparisonColor = Color.Default;
            }
            else if (diff > 0)
            {
                comparisonText = $"You're spending {diff:F0}% more than last month";
                comparisonColor = Color.Error;
            }
            else
            {
                comparisonText = $"You're spending {Math.Abs(diff):F0}% less than last month";
                comparisonColor = Color.Success;
            }
        }
        else
        {
            comparisonText = null;
        }
    }
}
