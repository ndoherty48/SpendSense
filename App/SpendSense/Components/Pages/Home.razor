@page "/"
@using Microsoft.EntityFrameworkCore
@using SpendSense.Common.Data
@using SpendSense.Common.Models
@using SpendSense.Common.Models.Enums
@using SpendSense.Common.Services
@inject SpendSenseDbContext Db
@inject SettingsService Settings

<h1>Dashboard</h1>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="PreviousMonth" />
    <MudText Typo="Typo.subtitle1">@(new DateTime(year, month, 1).ToString("MMMM yyyy"))</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="NextMonth" />
</MudStack>

<MudGrid>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle2">Income</MudText>
            <MudText Typo="Typo.h5" Color="Color.Success">£@totalIncome.ToString("F2")</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle2">Expenses</MudText>
            <MudText Typo="Typo.h5" Color="Color.Error">£@totalExpenses.ToString("F2")</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle2">Savings</MudText>
            <MudText Typo="Typo.h5" Color="Color.Info">£@totalSavings.ToString("F2")</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle2">Balance</MudText>
            <MudText Typo="Typo.h5" Color="@(balance >= 0 ? Color.Success : Color.Error)">£@balance.ToString("F2")</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@if (spendingByCategory.Any())
{
    <MudText Typo="Typo.h6" Class="mt-6 mb-2">Spending by Category</MudText>
    <MudChart ChartType="ChartType.Pie" ChartSeries="@chartData" ChartLabels="@chartLabels" Width="300px" Height="300px" T="double" />

    <MudSimpleTable Hover="true" Dense="true" Class="mt-4">
        <thead>
            <tr><th>Category</th><th>Spent</th><th>Budget</th></tr>
        </thead>
        <tbody>
            @foreach (var item in spendingByCategory)
            {
                var overspent = item.Budget > 0 && item.Spent > item.Budget;
                <tr style="@(overspent ? "color: var(--mud-palette-error); font-weight: bold;" : "")">
                    <td>@item.Category @if (overspent) { <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Error" /> }</td>
                    <td>£@item.Spent.ToString("F2")</td>
                    <td>@(item.Budget > 0 ? $"£{item.Budget:F2}" : "—")</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

@if (recentTransactions.Any())
{
    <MudText Typo="Typo.h6" Class="mt-6 mb-2">Recent Transactions</MudText>
    <MudSimpleTable Hover="true" Dense="true">
        <thead>
            <tr><th>Date</th><th>Description</th><th>Category</th><th>Amount</th></tr>
        </thead>
        <tbody>
            @foreach (var t in recentTransactions)
            {
                <tr>
                    <td>@t.TransactionDate.ToString("dd MMM")</td>
                    <td>@t.Description</td>
                    <td>@t.Category?.Name</td>
                    <td style="color: @(t.TransactionType == TransactionTypeEnum.Income ? "green" : "red")">
                        @(t.TransactionType == TransactionTypeEnum.Income ? "+" : "-")£@t.Amount.ToString("F2")
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

@code {
    int year;
    int month;
    double totalIncome;
    double totalExpenses;
    double totalSavings;
    double balance;
    List<(string Category, double Spent, double Budget)> spendingByCategory = [];
    List<Transaction> recentTransactions = [];
    List<ChartSeries<double>> chartData = [];
    string[] chartLabels = [];

    protected override async Task OnInitializedAsync()
    {
        year = Settings.ActiveBudgetYear;
        month = Settings.ActiveBudgetMonth;
        await LoadData();
    }

    async Task PreviousMonth()
    {
        if (month == 1) { month = 12; year--; }
        else { month--; }
        Settings.ActiveBudgetYear = year;
        Settings.ActiveBudgetMonth = month;
        await LoadData();
    }

    async Task NextMonth()
    {
        if (month == 12) { month = 1; year++; }
        else { month++; }
        Settings.ActiveBudgetYear = year;
        Settings.ActiveBudgetMonth = month;
        await LoadData();
    }

    async Task LoadData()
    {
        var startOfMonth = new DateTime(year, month, 1);
        var endOfMonth = startOfMonth.AddMonths(1);

        var monthTransactions = await Db.Transactions
            .Include(t => t.Category)
            .Where(t => t.TransactionDate >= startOfMonth && t.TransactionDate < endOfMonth)
            .ToListAsync();

        var budgets = await Db.MonthlyBudgets
            .Include(mb => mb.Category)
            .Where(mb => mb.Year == year && mb.Month == month)
            .ToListAsync();

        // When "income applies to next month" is on, pull income from the previous month
        if (Settings.IncomeAppliesNextMonth)
        {
            var prevStart = startOfMonth.AddMonths(-1);
            var incomeTransactions = await Db.Transactions
                .Where(t => t.TransactionDate >= prevStart && t.TransactionDate < startOfMonth && t.TransactionType == TransactionTypeEnum.Income)
                .ToListAsync();
            totalIncome = incomeTransactions.Sum(t => t.Amount);
        }
        else
        {
            totalIncome = monthTransactions
                .Where(t => t.TransactionType == TransactionTypeEnum.Income)
                .Sum(t => t.Amount);
        }

        totalExpenses = monthTransactions
            .Where(t => t.TransactionType == TransactionTypeEnum.Expense)
            .Sum(t => t.Amount);

        totalSavings = monthTransactions
            .Where(t => t.TransactionType == TransactionTypeEnum.Savings)
            .Sum(t => t.Amount);

        balance = totalIncome - totalExpenses - totalSavings;

        spendingByCategory = monthTransactions
            .Where(t => t.TransactionType == TransactionTypeEnum.Expense && t.Category is not null)
            .GroupBy(t => t.Category!.Name)
            .Select(g => (
                Category: g.Key,
                Spent: g.Sum(t => t.Amount),
                Budget: budgets.FirstOrDefault(b => b.Category?.Name == g.Key)?.BudgetedAmount ?? 0
            ))
            .OrderByDescending(x => x.Spent)
            .ToList();

        chartData = spendingByCategory.Select(x => new ChartSeries<double> { Name = x.Category, Data = new ChartData<double>(x.Spent) }).ToList();
        chartLabels = spendingByCategory.Select(x => x.Category).ToArray();

        recentTransactions = await Db.Transactions
            .Include(t => t.Category)
            .Where(t => t.TransactionDate >= startOfMonth && t.TransactionDate < endOfMonth)
            .OrderByDescending(t => t.TransactionDate)
            .Take(10)
            .ToListAsync();
    }
}
