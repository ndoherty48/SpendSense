@page "/recurring-transactions"
@using SpendSense.Common.Data.Repositories
@using SpendSense.Common.Models
@using SpendSense.Common.Models.Enums
@inject RecurringTransactionRepository Repository
@inject IDialogService Dialog

<PageHeader Title="Recurring transactions" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading recurring transactions" />
}
else if (!Elements!.Any())
{
    <EmptyState Icon="@Icons.Material.Filled.Autorenew"
                Title="No recurring transactions"
                Message="Tap + to add a salary, rent or subscription that repeats." />
}
else
{
    @foreach (var r in Elements!)
    {
        var income = r.TransactionType == TransactionTypeEnum.Income;
        <div class="item">
            <ListRow Title="@r.Name" Subtitle="@($"{r.Frequency} · {r.Category?.Name ?? "Uncategorised"} · from {r.StartDate:dd MMM yyyy}")" Href="@($"/recurring-transactions/edit/{r.Id}")">
                <Leading><IconTile Icon="@TransactionVisuals.Icon(r.TransactionType)" Tone="@TransactionVisuals.Tone(r.TransactionType)" Circle="true" /></Leading>
                <Trailing>
                    @if (!r.IsActive)
                    {
                        <Badge Tone="BadgeTone.Warn">Paused</Badge>
                    }
                    <Money Amount="@(income ? r.Amount : -r.Amount)" Symbol="@(r.Currency?.Symbol ?? "£")" Signed="true" Tone="@(income ? MoneyTone.Income : MoneyTone.Neutral)" />
                </Trailing>
            </ListRow>
            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" OnClick="() => Delete(r)" aria-label="@($"Delete {r.Name}")" />
        </div>
    }
}

@code {
    IEnumerable<RecurringTransaction>? Elements;
    bool _loading => Elements is null;

    protected override async Task OnInitializedAsync()
    {
        Elements = await Repository.GetAll();
    }

    async Task Delete(RecurringTransaction recurring)
    {
        var result = await Dialog.ShowMessageBoxAsync("Delete", $"Delete recurring transaction '{recurring.Name}'?", "Yes", "Cancel");
        if (result != true) return;
        await Repository.Delete(recurring);
        Elements = await Repository.GetAll();
    }
}
