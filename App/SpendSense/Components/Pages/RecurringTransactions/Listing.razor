@page "/recurring-transactions"
@using SpendSense.Common.Data.Repositories
@using SpendSense.Common.Models
@inject RecurringTransactionRepository Repository
@inject IDialogService Dialog

<h1>Recurring Transactions</h1>

<MudTable Items="@Elements" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@_loading" LoadingProgressColor="Color.Info">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Type</MudTh>
        <MudTh>Category</MudTh>
        <MudTh>Amount</MudTh>
        <MudTh>Frequency</MudTh>
        <MudTh>Start Date</MudTh>
        <MudTh>Active</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Type">
            <MudChip T="string" Size="Size.Small" Color="@(context.TransactionType == SpendSense.Common.Models.Enums.TransactionTypeEnum.Income ? Color.Success : context.TransactionType == SpendSense.Common.Models.Enums.TransactionTypeEnum.Savings ? Color.Info : Color.Error)">
                @context.TransactionType
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Category">@context.Category?.Name</MudTd>
        <MudTd DataLabel="Amount">@context.Currency?.Symbol@context.Amount.ToString("F2")</MudTd>
        <MudTd DataLabel="Frequency">@context.Frequency</MudTd>
        <MudTd DataLabel="Start Date">@context.StartDate.ToString("dd MMM yyyy")</MudTd>
        <MudTd DataLabel="Active">
            @if (context.IsActive)
            {
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
            }
        </MudTd>
        <MudTd><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Href="@($"/recurring-transactions/edit/{context.Id}")" /> <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => Delete(context)" /></MudTd>
    </RowTemplate>
</MudTable>

@code {
    IEnumerable<RecurringTransaction>? Elements;
    bool _loading => Elements is null;

    protected override async Task OnInitializedAsync()
    {
        Elements = await Repository.GetAll();
    }

    async Task Delete(RecurringTransaction recurring)
    {
        var result = await Dialog.ShowMessageBoxAsync("Delete", $"Delete recurring transaction '{recurring.Name}'?", "Yes", "Cancel");
        if (result != true) return;
        await Repository.Delete(recurring);
        Elements = await Repository.GetAll();
    }
}
