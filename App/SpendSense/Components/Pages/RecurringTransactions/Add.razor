@page "/recurring-transactions/add"
@layout FocusLayout
@using SpendSense.Common.Data.Repositories
@using SpendSense.Common.Models
@using SpendSense.Common.Models.Enums
@inject RecurringTransactionRepository RecurringRepo
@inject CategoryRepository CategoryRepo
@inject CurrencyRepository CurrencyRepo
@inject NavigationManager Navigation

<RecurringForm Title="New recurring transaction" Model="model" Categories="categories" Currencies="currencies" SubmitLabel="Add recurring transaction" OnSubmit="Submit" />

@code {
    RecurringTransaction model = new()
    {
        Name = "",
        Amount = 0,
        Frequency = FrequencyEnum.Monthly,
        TransactionType = TransactionTypeEnum.Expense,
        StartDate = DateTime.Today
    };
    IReadOnlyCollection<Category> categories = [];
    IReadOnlyCollection<Currency> currencies = [];

    protected override async Task OnInitializedAsync()
    {
        categories = await CategoryRepo.GetAll();
        currencies = await CurrencyRepo.GetAll();
        var defaultCurrency = currencies.FirstOrDefault(c => c.IsDefault);
        if (defaultCurrency is not null)
            model.CurrencyId = defaultCurrency.Id;
    }

    async Task Submit()
    {
        await RecurringRepo.Add(model);
        Navigation.NavigateTo("/recurring-transactions");
    }
}
