@page "/recurring-transactions/add"
@layout FocusLayout
@using SpendSense.Common.Data.Repositories
@using SpendSense.Common.Models
@using SpendSense.Common.Models.Enums
@inject RecurringTransactionRepository RecurringRepo
@inject CategoryRepository CategoryRepo
@inject AccountRepository AccountRepo
@inject SpendSense.Common.Services.AccountBalanceService Balances
@inject NavigationManager Navigation

@if (ready)
{
    <RecurringForm Title="New recurring transaction" Model="model" Categories="categories" Accounts="accounts" SubmitLabel="Add recurring transaction" OnSubmit="Submit" />
}

@code {
    RecurringTransaction model = new()
    {
        Name = "",
        Amount = 0,
        Frequency = FrequencyEnum.Monthly,
        TransactionType = TransactionTypeEnum.Expense,
        StartDate = DateTime.Today
    };
    IReadOnlyCollection<Category> categories = [];
    IReadOnlyList<SpendSense.Common.Services.AccountBalance> accounts = [];
    bool ready;

    protected override async Task OnInitializedAsync()
    {
        categories = await CategoryRepo.GetAll();
        accounts = await Balances.GetBalances();
        if (await AccountRepo.GetDefault() is { } defaultAccount)
            model.AccountId = defaultAccount.Id;
        ready = true;
    }

    async Task Submit()
    {
        await RecurringRepo.Add(model);
        Navigation.NavigateTo("/recurring-transactions");
    }
}
