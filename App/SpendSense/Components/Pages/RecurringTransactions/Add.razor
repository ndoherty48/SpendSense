@page "/recurring-transactions/add"
@using SpendSense.Common.Data.Repositories
@using SpendSense.Common.Models
@using SpendSense.Common.Models.Enums
@inject RecurringTransactionRepository RecurringRepo
@inject CategoryRepository CategoryRepo
@inject CurrencyRepository CurrencyRepo
@inject NavigationManager Navigation

<EditForm Model="@model" OnValidSubmit="OnValidSubmit">
<DataAnnotationsValidator/>
<MudGrid>
    <MudItem xs="12" sm="7">
        <MudCard>
            <MudCardContent>
                <MudTextField 
                    Label="Name" 
                    @bind-Value="model.Name" 
                    For="@(() => model.Name)"
                />
                <MudTextField 
                    Label="Description" 
                    Class="mt-3"
                    @bind-Value="model.Description"
                    Lines="2"
                />
                <MudSelect 
                    Label="Category (optional)" 
                    Class="mt-3"
                    @bind-Value="model.CategoryId"
                    For="@(() => model.CategoryId)"
                    Clearable="true"
                >
                    @foreach (var cat in categories)
                    {
                        <MudSelectItem Value="@((int?)cat.Id)">@cat.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField 
                    Label="Amount" 
                    Class="mt-3"
                    @bind-Value="model.Amount" 
                    For="@(() => model.Amount)"
                    Min="0.01"
                />
                <MudSelect 
                    Label="Currency" 
                    Class="mt-3"
                    @bind-Value="model.CurrencyId"
                    For="@(() => model.CurrencyId)"
                >
                    @foreach (var cur in currencies)
                    {
                        <MudSelectItem Value="cur.Id">@cur.Code - @cur.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect 
                    Label="Frequency" 
                    Class="mt-3"
                    @bind-Value="model.Frequency"
                    For="@(() => model.Frequency)"
                >
                    @foreach (var f in Enum.GetValues<FrequencyEnum>())
                    {
                        <MudSelectItem Value="f">@f</MudSelectItem>
                    }
                </MudSelect>
                <MudDatePicker 
                    Label="Start Date" 
                    Class="mt-3"
                    @bind-Date="startDate"
                />
                <MudNumericField 
                    Label="Day of Month (optional)" 
                    Class="mt-3"
                    @bind-Value="model.DayOfMonth"
                    Min="1" Max="31"
                />
            </MudCardContent>
            <MudCardActions>
                <MudButton 
                    ButtonType="ButtonType.Submit" 
                    Variant="Variant.Filled" 
                    Color="Color.Primary" 
                    Class="ml-auto"
                >Add</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="5">
        <MudPaper Class="pa-4 mud-height-full">
            <MudText Typo="Typo.subtitle2">Validation Summary</MudText>
            @if (success)
            {
                <MudText Color="Color.Success">Success</MudText>
            }
            else
            {
                <MudText Color="@Color.Error">
                    <ValidationSummary />
                </MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>
</EditForm>

@code {
    RecurringTransaction model = new()
    {
        Name = "",
        Amount = 0,
        Frequency = FrequencyEnum.Monthly,
        StartDate = DateTime.Today
    };
    DateTime? startDate = DateTime.Today;
    IReadOnlyCollection<Category> categories = [];
    IReadOnlyCollection<Currency> currencies = [];
    bool success;

    protected override async Task OnInitializedAsync()
    {
        categories = await CategoryRepo.GetAll();
        currencies = await CurrencyRepo.GetAll();
        var defaultCurrency = currencies.FirstOrDefault(c => c.IsDefault);
        if (defaultCurrency is not null)
            model.CurrencyId = defaultCurrency.Id;
    }

    async Task OnValidSubmit(EditContext context)
    {
        model.StartDate = startDate ?? DateTime.Today;
        await RecurringRepo.Add(model);
        success = true;
        Navigation.NavigateTo("/recurring-transactions");
    }
}
