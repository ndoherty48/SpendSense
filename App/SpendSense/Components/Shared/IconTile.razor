<span class="icon-tile @ToneClass @ShapeClass" style="@Style" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="currentColor" focusable="false">@((MarkupString)Icon)</svg>
</span>

@code {
    /// <summary>A MudBlazor icon string, e.g. <c>Icons.Material.Filled.ShoppingCart</c>.</summary>
    [Parameter, EditorRequired] public string Icon { get; set; } = "";

    [Parameter] public IconTone Tone { get; set; } = IconTone.Neutral;

    /// <summary>Circle for transactions, rounded square for categories.</summary>
    [Parameter] public bool Circle { get; set; }

    [Parameter] public int Size { get; set; } = 36;

    /// <summary>
    /// A user-chosen hex colour (accounts) that overrides <see cref="Tone"/>: the icon in that colour on a
    /// faint tint of it. Invalid values fall back to the tone.
    /// </summary>
    [Parameter] public string? Color { get; set; }

    string? SafeColor => AccountVisuals.SafeColor(Color);

    string ToneClass => SafeColor is not null ? "icon-tile--custom" : Tone switch
    {
        IconTone.Brand => "icon-tile--brand",
        IconTone.Accent => "icon-tile--accent",
        IconTone.Error => "icon-tile--error",
        _ => ""
    };

    string ShapeClass => Circle ? "icon-tile--circle" : "";

    // A 6-digit hex gets a 16% alpha tint behind it; other forms keep the neutral surface. Hex only, no
    // color-mix(): older Android WebViews don't support it.
    string Style
    {
        get
        {
            var style = $"--tile-size: {Size}px";
            if (SafeColor is { } c)
            {
                style += $"; --tile-color: {c}";
                if (c.Length == 7)
                    style += $"; --tile-tint: {c}29";
            }
            return style;
        }
    }
}
